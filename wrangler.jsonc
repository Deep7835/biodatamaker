{
  // Static site + a small Worker for Razorpay payments (only /api/* runs the Worker).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biodatamaker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Served only on the custom domain; no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Production domains (DNS records + certificates are created on deploy; the zone is on this Cloudflare account).
  "routes": [
    { "pattern": "marathibiodatamake.in", "custom_domain": true },
    { "pattern": "www.marathibiodatamake.in", "custom_domain": true }
  ],
  // Per-visitor limit on the payments API (20 requests / minute / IP).
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
  // Secrets (not in this file): RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, UNLOCK_SECRET
  //   npx wrangler secret put RAZORPAY_KEY_ID   (and the other two)
  // Local dev reads them from .dev.vars (see .dev.vars.example).
}
