# Copy to .env.local (read at `next build`). Leave any line empty to disable that service.
# See docs/SETUP-TRACKING.md for where to get each value.

# Cloudflare Web Analytics (cookieless, recommended)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# Google Analytics 4, e.g. G-ABC123XYZ
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project id (biodata content is masked in recordings)
NEXT_PUBLIC_CLARITY_ID=
# Search Console "HTML tag" content value (skip if you verify via DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 content value (skip if you import from Search Console)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
